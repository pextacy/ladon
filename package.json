{
  "name": "ladon",
  "private": true,
  "version": "0.0.0",
  "description": "A firewall between AI coding agents and the package registries.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:web": "pnpm --filter web dev",
    "demo:registry": "pnpm --filter demo registry",
    "demo:publish-canaries": "pnpm --filter demo publish-canaries",
    "demo:install-canary": "pnpm --filter demo install-canary",
    "eval": "pnpm --filter @ladon/core build && node scripts/eval.mjs",
    "demo:generate-canaries": "node demo/canaries/generate.mjs",
    "ladon": "node packages/cli/dist/index.js",
    "e2e:passkey": "node scripts/e2e-passkey.mjs",
    "bench": "pnpm --filter @ladon/cli build && node scripts/bench.mjs"
  }
}
