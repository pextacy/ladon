# Copy to .env — never commit real values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
ANTHROPIC_API_KEY=
# Atlas probe (apps/web/atlas/probe.ts). Models: bare ids go to Anthropic; "openai:<model>" and
# "openrouter:<vendor>/<model>" go to OpenAI-compatible APIs. Same total call cap for all models.
LADON_PROBE_MODELS=claude-opus-5-5
LADON_PROBE_MAX_PROMPTS=50
OPENAI_API_KEY=
# optional: any OpenAI-compatible endpoint (default https://api.openai.com/v1)
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
# optional: POST each newly registered Atlas name here (Slack/Discord-compatible JSON: text + content)
ATLAS_ALERT_WEBHOOK_URL=
# on | off — Ladon must work fully with LADON_AI=off
LADON_AI=off
# Local demo registry (Verdaccio). Never point canaries at a public registry.
LADON_DEMO_REGISTRY=http://localhost:4873/
