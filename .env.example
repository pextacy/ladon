# Copy to .env — never commit real values.

# --- apps/web (also set these on Vercel) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Required in production: ≥ 32 random chars (openssl rand -base64 48). Without it dashboard sign-in is off.
LADON_SESSION_SECRET=
# Public origin; also the WebAuthn RP ID. Must be set in production.
LADON_WEB_ORIGIN=https://ladon-one.vercel.app

# --- AI (optional; Ladon must work fully with LADON_AI=off) ---
ANTHROPIC_API_KEY=
LADON_AI=off
# LADON_AI_MODEL=claude-opus-5-5

# --- Atlas probe + alerts (apps/web/atlas/probe.ts) ---
# Models: bare ids go to Anthropic; "openai:<model>" and "openrouter:<vendor>/<model>" go to
# OpenAI-compatible APIs. Same total call cap for all models.
LADON_PROBE_MODELS=claude-opus-5-5
LADON_PROBE_MAX_PROMPTS=50
OPENAI_API_KEY=
# optional: any OpenAI-compatible endpoint (default https://api.openai.com/v1)
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
# optional: POST each newly registered Atlas name here (Slack/Discord-compatible JSON: text + content)
ATLAS_ALERT_WEBHOOK_URL=

# --- CLI ---
# LADON_WEB_URL=https://ladon-one.vercel.app
# LADON_HOME=~/.ladon
# LADON_DAEMON_PORT=7433

# Local demo registry (Verdaccio). Never point canaries at a public registry.
LADON_DEMO_REGISTRY=http://127.0.0.1:4873/
