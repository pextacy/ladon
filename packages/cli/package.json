{
  "name": "@ladon/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "ladon": "./dist/index.js"
  },
  "scripts": {
    "prebuild": "pnpm --filter @ladon/core build",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @ladon/core build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ladon/core": "workspace:*",
    "@simplewebauthn/server": "^13.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "optionalDependencies": {
    "serialport": "^13.0.0"
  }
}
