{
  "name": "@ladon/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai/provider.d.ts",
      "default": "./dist/ai/provider.js"
    },
    "./data/*": "./data/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "acorn": "^8.19.0",
    "semver": "^7.8.6",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/semver": "^7.8.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "files": [
    "dist",
    "data"
  ]
}
